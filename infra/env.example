# Copy to /opt/closdex/.env and fill in real values.
# This file is read by both the API systemd service and the deploy script.
# NEVER commit the real .env — only this template.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://closdex:CHANGE_ME@localhost:5432/closdex?schema=public

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_random_chars

# ── LLM (NVIDIA NIM) ────────────────────────────────────────
# ROTATE THIS — old key was exposed publicly
OPENAI_API_KEY=nvapi-ROTATE_ME
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=meta/llama-3.3-70b-instruct
AI_PROVIDER=openai

# ── API server ──────────────────────────────────────────────
PORT=4000
HOST=127.0.0.1
NODE_ENV=production
SCORING_WORKER_CONCURRENCY=4

# ── DO NOT SET these in the web service env ─────────────────
# NEXT_PUBLIC_API_URL  <-- leave unset; Next.js rewrites handle /api/* proxying
