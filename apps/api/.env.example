# Closdex API — environment variables
#
# Copy to .env (or .env.local) and fill in. The file is gitignored.
# Anything left blank uses the default shown in the comment.

# ─── Core ────────────────────────────────────────────────────────────────

# HTTP port. main.ts: defaults to 4000.
PORT=4000

# JWT signing secret. main.ts/auth.module: defaults to "change-me" — DO NOT
# ship the default to production. Generate a long random string.
JWT_SECRET=change-me

# Postgres. Used by Prisma in packages/db.
DATABASE_URL=postgresql://closdex:closdex@localhost:5432/closdex?schema=public

# Redis. Used for leaderboards + BullMQ scoring queue.
REDIS_URL=redis://localhost:6379

# BullMQ scoring worker concurrency. scoring.worker.ts: defaults to 5.
SCORING_WORKER_CONCURRENCY=5


# ─── LLM provider (lead AI + evaluator) ──────────────────────────────────
#
# Two providers wired: openai (default) and anthropic. Switch with AI_PROVIDER.
# The OpenAI provider also works with any OpenAI-compatible endpoint
# (NVIDIA NIM, OpenRouter, vLLM, etc.) — set OPENAI_BASE_URL.

AI_PROVIDER=openai

# ─── A) OpenAI production setup ──────────────────────────────────────────
# Get the key at platform.openai.com. Set a hard spending cap on the
# dashboard ($10–20 is plenty for early users). Leave OPENAI_BASE_URL unset
# so the SDK talks to api.openai.com directly.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# ─── B) NVIDIA NIM free-tier setup (for testing) ─────────────────────────
# Get the key at build.nvidia.com. Free tier is rate-limited; fine for
# demos but not for sustained production traffic. Same OPENAI_* keys are
# reused — the OpenAI SDK handles the redirect transparently.
#
# OPENAI_API_KEY=nvapi-...
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=meta/llama-3.3-70b-instruct
# (other good NIM picks: nvidia/llama-3.3-nemotron-super-49b-v1,
#  qwen/qwen2.5-72b-instruct, deepseek-ai/deepseek-v3)

# ─── C) Anthropic fallback ───────────────────────────────────────────────
# Only used when AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5


# ─── Razorpay (deferred — slice 2 of M7) ─────────────────────────────────
# Add when ready to charge real money for placements / featured listings.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
