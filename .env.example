# ─── Database / cache ───────────────────────────────────────────────
DATABASE_URL="postgresql://closdex:closdex@localhost:5432/closdex?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── Auth ───────────────────────────────────────────────────────────
JWT_SECRET="change-me"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ─── AI provider (pluggable — see README) ───────────────────────────
AI_PROVIDER="openai"            # openai | anthropic
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ─── Payments (Razorpay) ────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ─── Storage (S3 / R2) ──────────────────────────────────────────────
S3_ENDPOINT=""
S3_BUCKET="closdex-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
